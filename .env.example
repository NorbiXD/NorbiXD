# Copy to .env and fill in. Never commit real secrets.

# Database (docker compose provides Postgres; default is local SQLite)
DARWIN_DATABASE_URL=postgresql://darwin:darwin@postgres:5432/darwin

# Operator token for POST /api/kill-switch (endpoint disabled when unset)
DARWIN_OPERATOR_TOKEN=

# Bybit testnet (mode: testnet) — https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Bybit mainnet (mode: live). Live also requires challenge.live_enabled: true AND:
# DARWIN_LIVE_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
BYBIT_API_KEY=
BYBIT_API_SECRET=
DARWIN_LIVE_CONFIRM=

# Intelligence providers (feature-gated in challenge.yaml)
TYPESAFE_API_KEY=
XAI_API_KEY=
